{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oahu-disposal/v1-disposal-data.schema.json",
  "title": "Oʻahu Disposal Finder V1 Dataset",
  "type": "object",
  "required": [
    "metadata",
    "sources",
    "facilities",
    "clarification_groups",
    "items"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "schema_version",
        "dataset_version",
        "verified_on",
        "coverage"
      ],
      "properties": {
        "name": { "type": "string" },
        "schema_version": { "type": "string" },
        "dataset_version": { "type": "string" },
        "verified_on": { "type": "string" },
        "coverage": { "type": "object" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "organization",
          "url",
          "role",
          "verified_on"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "organization": { "type": "string" },
          "url": { "type": "string" },
          "role": { "type": "string" },
          "verified_on": { "type": "string" }
        }
      }
    },
    "facilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "address",
          "hours",
          "source_ids"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "address": { "type": "string" },
          "hours": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "clarification_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "triggers",
          "prompt",
          "options"
        ],
        "properties": {
          "id": { "type": "string" },
          "triggers": { "type": "array", "items": { "type": "string" } },
          "prompt": { "type": "string" },
          "options": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "aliases",
          "primary_pathway",
          "preparation",
          "restrictions",
          "prohibitions",
          "alternatives",
          "source_ids",
          "verified_on",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^IT-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "primary_pathway": {
            "type": "object",
            "required": [
              "type",
              "next_action",
              "facility_ids"
            ],
            "properties": {
              "type": { "type": "string" },
              "next_action": { "type": "string" },
              "facility_ids": { "type": "array", "items": { "type": "string" } }
            }
          },
          "preparation": { "type": "array" },
          "restrictions": { "type": "array" },
          "prohibitions": { "type": "array" },
          "alternatives": { "type": "array" },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "verified_on": { "type": "string" },
          "notes": { "type": "array" }
        }
      }
    }
  }
}
